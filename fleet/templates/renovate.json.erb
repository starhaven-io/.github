{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>starhaven-io/.github:renovate-config#<%= fleet_version %>"],
  "ignorePresets": ["mergeConfidence:all-badges"]<% if ruby_runtime && ruby_runtime["update-companions"] %>,
  "packageRules": [
    {
      "description": "The companion managers own this runtime as one dependency.",
      "matchManagers": ["ruby-version"],
      "matchFileNames": [<%= JSON.generate(ruby_runtime.fetch("version-file")) %>],
      "enabled": false
    },
    {
      "matchDatasources": ["custom.ruby-builder-ubuntu"],
      "matchFileNames": <%= JSON.generate(RubyRuntime.paths(ruby_runtime)) %>,
      "enabled": true,
      "groupName": "Ruby runtime",
      "groupSlug": "ruby-runtime",
      "group": { "branchTopic": "ruby-{{{newMajor}}}.x" }
    },
    {
      "description": "A replaced same-version archive requires investigation.",
      "matchDatasources": ["custom.ruby-builder-ubuntu"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]<% end %>
}
