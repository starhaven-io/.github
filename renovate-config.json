{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Starhaven tool pins that are outside Dependabot-managed ecosystems.",
  "extends": [
    ":gitSignOff"
  ],
  "ignorePresets": [
    "mergeConfidence:all-badges"
  ],
  "enabledManagers": [
    "ruby-version",
    "rust-toolchain",
    "custom.regex"
  ],
  "automerge": false,
  "platformCommit": "enabled",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Require manual investigation when cargo-deny replaces an archive without a new release version.",
      "matchDatasources": [
        "custom.cargo-deny-linux"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    }
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prBodyColumns": [
    "Package",
    "Update",
    "Change",
    "Pending"
  ],
  "prBodyTemplate": "{{{table}}}{{{warnings}}}{{{controls}}}",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update cargo-installed tools pinned in GitHub Actions workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "cargo install (?<depName>[A-Za-z0-9_-]+) --locked --version (?<currentValue>\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)\\s"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update Vale's release tag and matching archive SHA-256 together.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)VALE_SHA256:\\s*\"(?<currentDigest>[a-f0-9]{64})\"[\\r\\n]+[ \\t]*VALE_VERSION:\\s*\"(?<version>\\d+(?:\\.\\d+){2})\""
      ],
      "currentValueTemplate": "v{{{version}}}",
      "depNameTemplate": "Vale",
      "packageNameTemplate": "vale-cli/vale",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{indentation}}}VALE_SHA256: \"{{{newDigest}}}\"\n{{{indentation}}}VALE_VERSION: \"{{{replace '^v' '' newValue}}}\""
    },
    {
      "customType": "regex",
      "description": "Update literal Vale release URLs, archive names, and SHA-256 together; retain the legacy env-pair manager until consumers migrate.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "VALE_SHA256:\\s*\"(?<currentDigest>[a-f0-9]{64})\"(?:[\\s\\S]*?)https://github\\.com/vale-cli/vale/releases/download/(?<currentValue>v\\d+(?:\\.\\d+){2})/vale_\\d+(?:\\.\\d+){2}_Linux_64-bit\\.tar\\.gz"
      ],
      "depNameTemplate": "Vale",
      "packageNameTemplate": "vale-cli/vale",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{replace currentDigest newDigest (replace 'https://github[.]com/vale-cli/vale/releases/download/.*$' '' replaceString)}}}{{else}}{{{replace 'https://github[.]com/vale-cli/vale/releases/download/.*$' '' replaceString}}}{{/if}}https://github.com/vale-cli/vale/releases/download/{{{newValue}}}/vale_{{{replace '^v' '' newValue}}}_Linux_64-bit.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Update OpenTofu versions pinned in GitHub Actions workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "TOFU_VERSION:\\s*\"(?<currentValue>\\d+(?:\\.\\d+){2})\""
      ],
      "depNameTemplate": "OpenTofu",
      "packageNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update lychee's release archive SHA-256 and the literal download URL together.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "LYCHEE_SHA256:\\s*\"(?<currentDigest>[a-f0-9]{64})\"(?:[\\s\\S]*?)releases/download/(?<currentValue>lychee-v\\d+(?:\\.\\d+){2})/lychee-x86_64-unknown-linux-gnu\\.tar\\.gz"
      ],
      "depNameTemplate": "lychee",
      "packageNameTemplate": "lycheeverse/lychee",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^lychee-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update typos's archive SHA-256 and literal URL within one conventionally indented workflow step.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)          TYPOS_SHA256:[ \\t]*\"(?<currentDigest>[a-f0-9]{64})\"[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n        run:[ \\t]*\\|[-+]?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?: {10}[^\\r\\n]*\\r?\\n|[ \\t]*\\r?\\n)*? {10}[^\\r\\n]*?https://github\\.com/crate-ci/typos/releases/download/(?<currentValue>v\\d+(?:\\.\\d+){2})/typos-v\\d+(?:\\.\\d+){2}-x86_64-unknown-linux-musl\\.tar\\.gz"
      ],
      "depNameTemplate": "typos",
      "packageNameTemplate": "crate-ci/typos",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{replace currentDigest newDigest (replace 'https://github[.]com/crate-ci/typos/releases/download/.*$' '' replaceString)}}}{{else}}{{{replace 'https://github[.]com/crate-ci/typos/releases/download/.*$' '' replaceString}}}{{/if}}https://github.com/crate-ci/typos/releases/download/{{{newValue}}}/typos-{{{newValue}}}-x86_64-unknown-linux-musl.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Update cargo-deny's Linux archive SHA-256 and literal URL within one conventionally indented workflow step.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)          CARGO_DENY_SHA256:[ \\t]*\"(?<currentDigest>[a-f0-9]{64})\"[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n        run:[ \\t]*\\|[-+]?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?: {10}[^\\r\\n]*\\r?\\n|[ \\t]*\\r?\\n)*? {10}[^\\r\\n]*?https://github\\.com/EmbarkStudios/cargo-deny/releases/download/(?<currentValue>\\d+(?:\\.\\d+){2})/cargo-deny-\\d+(?:\\.\\d+){2}-x86_64-unknown-linux-musl\\.tar\\.gz"
      ],
      "depNameTemplate": "cargo-deny",
      "packageNameTemplate": "EmbarkStudios/cargo-deny",
      "datasourceTemplate": "custom.cargo-deny-linux",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{replace currentDigest newDigest (replace 'https://github[.]com/EmbarkStudios/cargo-deny/releases/download/.*$' '' replaceString)}}}{{else}}{{{replace 'https://github[.]com/EmbarkStudios/cargo-deny/releases/download/.*$' '' replaceString}}}{{/if}}https://github.com/EmbarkStudios/cargo-deny/releases/download/{{{newValue}}}/cargo-deny-{{{newValue}}}-x86_64-unknown-linux-musl.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Update cargo-nextest's Linux archive SHA-256 and literal URL within one conventionally indented workflow step.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)          CARGO_NEXTEST_SHA256:[ \\t]*\"(?<currentDigest>[a-f0-9]{64})\"[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n        run:[ \\t]*\\|[-+]?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?: {10}[^\\r\\n]*\\r?\\n|[ \\t]*\\r?\\n)*? {10}[^\\r\\n]*?https://github\\.com/nextest-rs/nextest/releases/download/(?<currentValue>cargo-nextest-\\d+(?:\\.\\d+){2})/cargo-nextest-\\d+(?:\\.\\d+){2}-x86_64-unknown-linux-musl\\.tar\\.gz"
      ],
      "depNameTemplate": "cargo-nextest",
      "packageNameTemplate": "nextest-rs/nextest",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^cargo-nextest-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{replace currentDigest newDigest (replace 'https://github[.]com/nextest-rs/nextest/releases/download/.*$' '' replaceString)}}}{{else}}{{{replace 'https://github[.]com/nextest-rs/nextest/releases/download/.*$' '' replaceString}}}{{/if}}https://github.com/nextest-rs/nextest/releases/download/{{{newValue}}}/{{{newValue}}}-x86_64-unknown-linux-musl.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Update cargo-llvm-cov's Linux archive SHA-256 and literal URL within one conventionally indented workflow step.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)          CARGO_LLVM_COV_SHA256:[ \\t]*\"(?<currentDigest>[a-f0-9]{64})\"[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n        run:[ \\t]*\\|[-+]?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?: {10}[^\\r\\n]*\\r?\\n|[ \\t]*\\r?\\n)*? {10}[^\\r\\n]*?https://github\\.com/taiki-e/cargo-llvm-cov/releases/download/(?<currentValue>v\\d+(?:\\.\\d+){2})/cargo-llvm-cov-x86_64-unknown-linux-musl\\.tar\\.gz"
      ],
      "depNameTemplate": "cargo-llvm-cov",
      "packageNameTemplate": "taiki-e/cargo-llvm-cov",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{replace currentDigest newDigest (replace 'https://github[.]com/taiki-e/cargo-llvm-cov/releases/download/.*$' '' replaceString)}}}{{else}}{{{replace 'https://github[.]com/taiki-e/cargo-llvm-cov/releases/download/.*$' '' replaceString}}}{{/if}}https://github.com/taiki-e/cargo-llvm-cov/releases/download/{{{newValue}}}/cargo-llvm-cov-x86_64-unknown-linux-musl.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Update the strict workflow audit container version and digest together.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "ZIZMOR_IMAGE:\\s*\"(?<depName>ghcr\\.io/zizmorcore/zizmor):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "customDatasources": {
    "cargo-deny-linux": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/EmbarkStudios/cargo-deny/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$[draft = false and prerelease = false].($release := $; $archive := assets[name = 'cargo-deny-' & $release.tag_name & '-x86_64-unknown-linux-musl.tar.gz']; $count($archive) = 1 and $archive.state = 'uploaded' and $type($archive.digest) = 'string' and $type(published_at) = 'string' ? ($exists($match(tag_name, /^[0-9]+\\.[0-9]+\\.[0-9]+$/)) and $exists($match($archive.digest, /^sha256:[a-f0-9]{64}$/)) ? {\"version\": tag_name, \"releaseTimestamp\": published_at, \"digest\": $substringAfter($archive.digest, 'sha256:'), \"changelogUrl\": html_url}))], \"sourceUrl\": \"https://github.com/EmbarkStudios/cargo-deny\"}"
      ]
    }
  }
}
